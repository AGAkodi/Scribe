# Copy to a local, ignored .env file; never commit real credentials.
SCRIBE_PAIRING_CODE=replace-with-at-least-24-random-characters
# Optional reusable code for development and judges. Works until the expiry
# (ISO 8601, UTC if no offset); leave blank to disable. Removing or rotating
# it and restarting revokes every session it created.
SCRIBE_ACCESS_CODE=
SCRIBE_ACCESS_CODE_EXPIRES=
NOTION_TOKEN=
NOTION_PROJECTS_ID=
NOTION_IDEAS_ID=
NOTION_API_VERSION=2022-06-28
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
DATABASE_PATH=scribe.sqlite3
ALLOWED_ORIGINS=http://localhost:5173
